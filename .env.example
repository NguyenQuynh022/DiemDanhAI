FLASK_APP=app.py
FLASK_ENV=development

SECRET_KEY=change-this-secret-key

# =========================================================
# MYSQL
# =========================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=attendance_system

