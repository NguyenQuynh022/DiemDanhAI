ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# =========================================================
# EMAIL SMTP (Giảng viên gửi mail cho lớp học phần)
# Với Gmail: Bật xác thực 2 bước -> Tạo App Password 16 ký tự
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduPortal - Hệ thống Đào tạo

